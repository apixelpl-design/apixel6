---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  image: ImageMetadata;
  alt: string;
  name: string;
  variant?: 'hero' | 'card' | 'desktop' | 'phone';
  width?: number;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  priority?: boolean;
  browserLabel?: string;
  frameless?: boolean;
}
const {
  image,
  alt,
  name,
  variant = 'card',
  width = 900,
  widths = [450, 900],
  sizes = '(max-width: 700px) 100vw, 50vw',
  eager = false,
  priority = variant === 'hero' && eager,
  browserLabel = variant === 'hero' ? 'Wybrana realizacja / APIXEL' : name,
  frameless = false,
} = Astro.props;
---

<div
  class={`site-preview site-preview--${variant}${frameless ? ' site-preview--frameless' : ''}`}
  data-site-preview
  data-preview-name={name}
>
  {!frameless && ['hero', 'desktop'].includes(variant) && (
    <div class="browser-top" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      <span>{browserLabel}</span>
    </div>
  )}
  <div class="site-preview-viewport" data-preview-viewport>
    <Image
      src={image}
      width={width}
      widths={widths}
      sizes={sizes}
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      draggable="false"
      alt={alt}
    />
  </div>
</div>

<script>
  import { initSitePreviews } from '../scripts/site-previews';
  initSitePreviews();
</script>
