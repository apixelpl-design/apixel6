---
import { pages } from '../data/navigation';
---

<a
  class="portfolio-link"
  href={pages.portfolio.href}
  data-cta="service_portfolio"
>
  <div class="portfolio-link-title">
    <span class="portfolio-link-label">Projekty APIXEL</span>
    <h2>
      Zobacz nasze
      <br />
      realizacje.
    </h2>
  </div>
  <svg
    class="portfolio-link-arrow"
    width="88"
    height="88"
    viewBox="0 0 88 88"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    aria-hidden="true"
  >
    <path d="M18 70 70 18M18 18h52v52" />
  </svg>
</a>

<style>
  .portfolio-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    gap: 32px;
    padding: 40px 64px 40px 40px;
    background: var(--apx-black);
    color: var(--apx-white);
    text-decoration: none;
  }
  .portfolio-link::before {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 36%;
    background: var(--apx-red);
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
  }
  .portfolio-link-title,
  .portfolio-link-arrow {
    position: relative;
  }
  .portfolio-link-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
    color: var(--apx-muted);
  }
  .portfolio-link h2 {
    font-size: clamp(32px, 3vw, 44px);
  }
  .portfolio-link-arrow {
    flex-shrink: 0;
    transition: transform 180ms ease;
  }
  .portfolio-link:hover .portfolio-link-arrow {
    transform: translate(4px, -4px);
  }
  @media (max-width: 600px) {
    .portfolio-link {
      padding: 32px 24px;
      gap: 16px;
    }
    .portfolio-link::before {
      width: 28%;
    }
    .portfolio-link-arrow {
      width: 44px;
      height: 44px;
    }
    .portfolio-link h2 {
      font-size: 30px;
    }
    .portfolio-link-label {
      font-size: 11px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-link-arrow {
      transition: none;
    }
    .portfolio-link:hover .portfolio-link-arrow {
      transform: none;
    }
  }
</style>
