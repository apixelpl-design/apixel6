---
import { contactHref } from '../data/site';
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  description: string;
  cta?: string;
  ctaHref?: string;
  service?: string;
  secondary?: { label: string; href: string };
  compact?: boolean;
}
const {
  eyebrow,
  title,
  accent,
  description,
  cta = 'Porozmawiajmy o projekcie',
  ctaHref,
  service = 'strona-seo',
  secondary,
  compact = false,
} = Astro.props;
---

<header class:list={['page-hero', { 'page-hero-compact': compact }]}>
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>
      {title}
      {accent && (
        <>
          <br />
          <span class="accent">{accent}</span>
        </>
      )}
    </h1>
    <p class="lead">{description}</p>
    <slot name="offer" />
    <div class="actions">
      <a
        class="button"
        href={ctaHref ?? contactHref(service)}
        data-cta="service_hero"
      >
        {cta} <span aria-hidden="true">↗</span>
      </a>
      {secondary && (
        <a class="text-link" href={secondary.href}>
          {secondary.label} <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</header>
