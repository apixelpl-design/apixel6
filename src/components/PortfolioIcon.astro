---
import type { PortfolioMetricIcon } from '../data/portfolio';
interface Props {
  icon: PortfolioMetricIcon;
}
const { icon } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  {icon === 'visibility' && (
    <>
      <path d="M3 16s5-9 13-9 13 9 13 9-5 9-13 9S3 16 3 16Z" />
      <circle cx="16" cy="16" r="4" />
    </>
  )}
  {icon === 'click' && (
    <>
      <path d="m8 5 17 13-8 1-4 8L8 5Z" />
      <path d="m19 20 6 7M22 7l3-3M26 12h4M17 4V1" />
    </>
  )}
  {icon === 'contact' && (
    <>
      <path d="M4 6h24v17H14l-7 5v-5H4V6Z" />
      <path d="M10 12h12M10 17h8" />
    </>
  )}
</svg>
<style>
  svg {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }
</style>
