---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioLink from '../../components/PortfolioLink.astro';
import Faq from '../../components/Faq.astro';
import ContactSection from '../../components/ContactSection.astro';
import ServicePrice from '../../components/ServicePrice.astro';
import ServiceOfferSection from '../../components/ServiceOfferSection.astro';
import { serviceFaq } from '../../data/faq';
import { priceLabel } from '../../data/services';
import { websiteOffer } from '../../data/website-offer';
const description = `Tworzymy strony internetowe dla firm z Warszawy i okolic za ${priceLabel(websiteOffer.price, false, false)}. Projekt, wdrożenie i podstawy SEO. Zobacz realizacje i poproś o wycenę.`;
---

<BaseLayout
  title="Tworzenie stron internetowych Warszawa | APIXEL"
  description={description}
  breadcrumbs={[
    { name: 'APIXEL', path: '/' },
    { name: 'Strony internetowe', path: '/uslugi/strona/' },
  ]}
>
  <ServiceOfferSection
    service="strona"
    title="Tworzenie stron internetowych"
    accent="dla firm z Warszawy i okolic."
  >
    <div class="seo-addon">
      <div>
        <h3>Chcesz rozwijać stronę w Google?</h3>
        <p>
          Pozycjonowanie, rozwój treści i bloga w osobnym abonamencie. Zakres
          oraz liczbę artykułów ustalamy w propozycji.
        </p>
      </div>
      <div>
        <ServicePrice service="seo" />
        <a class="text-link" href="/widocznosc/">
          Zobacz zakres SEO ↗
        </a>
      </div>
    </div>
    <div class="portfolio-shortcut" id="realizacje">
      <PortfolioLink />
    </div>
    <div class="scope-links">
      <a class="text-link" href="/poradnik/one-page-czy-podstrony/">
        One page czy strona z podstronami ↗
      </a>
      <a class="text-link" href="/poradnik/ile-kosztuje-strona-firmowa/">
        Co wpływa na wycenę strony ↗
      </a>
    </div>
  </ServiceOfferSection>
  <Faq title="Pytania przed zamówieniem strony" items={serviceFaq.strona} />
  <ContactSection service="strona" />
</BaseLayout>

<style>
  .portfolio-shortcut {
    margin-top: 24px;
  }
  .seo-addon {
    margin-top: 32px;
    padding: 24px;
    border-left: 3px solid var(--apx-red);
    background: var(--apx-white);
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .seo-addon p {
    max-width: 660px;
    margin-top: 12px;
  }
  @media (max-width: 700px) {
    .seo-addon {
      flex-direction: column;
    }
  }
  .scope-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin-top: 16px;
  }
</style>
