---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, contact } from '../data/site';
import { pages } from '../data/navigation';
---

<BaseLayout
  title={`${pages.contact.label} | ${site.name}`}
  description={
    contact.formEnabled ? contact.formDescription : contact.description
  }
  breadcrumbs={[
    { name: site.name, path: '/' },
    { name: pages.contact.label, path: pages.contact.href },
  ]}
>
  <ContactSection asPage />
</BaseLayout>
