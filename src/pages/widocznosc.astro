---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceOfferSection from '../components/ServiceOfferSection.astro';
import PortfolioLink from '../components/PortfolioLink.astro';
import Faq from '../components/Faq.astro';
import ContactSection from '../components/ContactSection.astro';
import { serviceFaq } from '../data/faq';
import { primaryServices, priceLabel } from '../data/services';
const description = `Pozycjonowanie stron dla firm z Warszawy i okolic ${priceLabel(primaryServices.seo.price, true)}. Audyt, treści, techniczne SEO, poprawa konwersji i miesięczny raport.`;
---

<BaseLayout
  title="Pozycjonowanie stron internetowych Warszawa | APIXEL"
  description={description}
  breadcrumbs={[
    { name: 'APIXEL', path: '/' },
    { name: 'Pozycjonowanie', path: '/widocznosc/' },
  ]}
>
  <ServiceOfferSection
    service="seo"
    title="Pozycjonowanie stron internetowych"
    accent="dla firm z Warszawy i okolic."
  >
    <div class="portfolio-shortcut" id="realizacje">
      <PortfolioLink />
    </div>
    <div class="seo-guide-links">
      <a class="text-link" href="/poradnik/seo-przy-budowie-a-pozycjonowanie/">
        SEO przy budowie strony i późniejsze pozycjonowanie{' '}
        <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="/poradnik/strona-ma-ruch-ale-brak-zapytan/">
        Co poprawić, gdy strona ma ruch i mało zapytań{' '}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </ServiceOfferSection>
  <Faq title="Pytania przed rozpoczęciem SEO" items={serviceFaq.seo} />
  <ContactSection service="seo" />
</BaseLayout>

<style>
  .portfolio-shortcut {
    margin-top: 24px;
  }
  .seo-guide-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 16px;
  }
</style>
