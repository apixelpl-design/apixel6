---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import GuideOfferSummary from '../../components/GuideOfferSummary.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import { primaryServices } from '../../data/services';
export async function getStaticPaths() {
  return (await getCollection('guides')).map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}
interface Props {
  guide: CollectionEntry<'guides'>;
}
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const project = projects.find(
  (item) => item.slug === guide.data.relatedProject,
);
const path = `/poradnik/${guide.id}/`;
const service = primaryServices[guide.data.relatedService];
const tableOfContents = headings.filter((heading) => heading.depth === 2);
if (guide.data.offerSummary) {
  tableOfContents.unshift({
    depth: 2,
    slug: 'cena-strony-apixel',
    text: 'Ile kosztuje strona firmowa w APIXEL?',
  });
}
const relationScore = (item: CollectionEntry<'guides'>) => {
  const explicitOrder = guide.data.relatedGuides.indexOf(item.id);
  if (explicitOrder >= 0) {
    return 1000 + guide.data.relatedGuides.length - explicitOrder;
  }
  return (
    (item.data.category === guide.data.category ? 20 : 0) +
    (item.data.relatedService === guide.data.relatedService ? 10 : 0)
  );
};
const related = (await getCollection('guides'))
  .filter((item) => item.id !== guide.id && relationScore(item) > 0)
  .sort(
    (a, b) =>
      relationScore(b) - relationScore(a) || a.id.localeCompare(b.id, 'pl'),
  )
  .slice(0, 3);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.publishedAt.toISOString(),
  dateModified: (guide.data.updatedAt ?? guide.data.publishedAt).toISOString(),
  author: { '@type': 'Organization', name: guide.data.author, url: site.url },
  publisher: { '@id': `${site.url}/#organization` },
  image: new URL(site.sharingImage, site.url).href,
  mainEntityOfPage: `${site.url}${path}`,
  inLanguage: 'pl-PL',
};
---

<BaseLayout
  title={`${guide.data.title} | APIXEL`}
  description={guide.data.description}
  type="article"
  schema={articleSchema}
  breadcrumbs={[
    { name: 'APIXEL', path: '/' },
    { name: 'Poradnik', path: '/poradnik/' },
    { name: guide.data.title, path },
  ]}
>
  <header class="page-hero page-hero-compact">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ścieżka strony">
        <a href="/poradnik/">Poradnik</a>
        <span aria-hidden="true">/</span>
        <span>{guide.data.category}</span>
      </nav>
      <p class="eyebrow">{guide.data.category}</p>
      <h1 style="font-size:clamp(32px,3.8vw,52px)">{guide.data.title}</h1>
      <p class="lead">{guide.data.description}</p>
      <div class="article-meta">
        <a href="#redakcja-poradnika">{guide.data.author}</a>
        <time
          datetime={(
            guide.data.updatedAt ?? guide.data.publishedAt
          ).toISOString()}
        >
          {guide.data.updatedAt ? 'Zaktualizowano:' : 'Opublikowano:'}{' '}
          {(guide.data.updatedAt ?? guide.data.publishedAt).toLocaleDateString(
            'pl-PL',
            {
              timeZone: 'Europe/Warsaw',
            },
          )}
        </time>
      </div>
    </div>
  </header>
  <section class="section section-white">
    <div class="container article-layout">
      <aside class="article-aside">
        <details class="article-toc">
          <summary class="article-toc-summary">
            <h2>W tym poradniku</h2>
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <nav aria-label="Spis treści poradnika">
            <ul class="article-toc-list">
              {tableOfContents.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
        <div class="article-offer-link">
          <p>Cena i zakres usługi dla Twojej firmy.</p>
          <a class="button" href={service.href}>
            {guide.data.relatedService === 'strona'
              ? 'Zobacz ofertę stron'
              : 'Zobacz ofertę SEO'}{' '}
            ↗
          </a>
        </div>
      </aside>
      <article class="article-content">
        {guide.data.offerSummary && <GuideOfferSummary />}
        <Content />
        {project && (
          <div class="case-section">
            <h2>Przykład z portfolio APIXEL</h2>
            <p>{project.summary}</p>
            <a class="text-link" href={`/portfolio/${project.slug}/`}>
              Zobacz zakres projektu {project.name} ↗
            </a>
          </div>
        )}
        <footer class="article-editorial" id="redakcja-poradnika">
          <h2>O redakcji poradnika</h2>
          <p>
            {guide.data.author}. Projektujemy i wdrażamy strony dla firm oraz
            pracujemy nad ich widocznością w Google. W poradnikach opisujemy
            zakres usług i pokazujemy przykłady z realizacji APIXEL.
          </p>
          <p>
            Poznaj <a href="/uslugi/strona/">tworzenie stron internetowych</a>,
            <a href="/widocznosc/">pozycjonowanie</a> i
            <a href="/portfolio/">wykonane projekty</a>.
          </p>
        </footer>
      </article>
    </div>
  </section>
  <section class="section section-light">
    <div class="container">
      <div class="section-heading">
        <h2>Powiązane poradniki</h2>
      </div>
      <div class="article-grid">
        {related.map((item) => (
          <article class="article-card">
            <p class="eyebrow">{item.data.category}</p>
            <h3>
              <a href={`/poradnik/${item.id}/`}>{item.data.title}</a>
            </h3>
            <a class="text-link" href={`/poradnik/${item.id}/`}>
              Przeczytaj ↗
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <ContactSection service={guide.data.relatedService} />
</BaseLayout>
