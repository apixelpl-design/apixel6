---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
const guides = (await getCollection('guides')).sort((a, b) =>
  a.id.localeCompare(b.id, 'pl'),
);
---

<BaseLayout
  title="Poradnik: strona firmowa, SEO i zapytania | APIXEL"
  description="Jak wybrać stronę dla firmy, porównać zakres wycen i rozwijać widoczność w Google? Praktyczne odpowiedzi i przykłady realizacji APIXEL."
  breadcrumbs={[
    { name: 'APIXEL', path: '/' },
    { name: 'Poradnik', path: '/poradnik/' },
  ]}
>
  <PageHero
    eyebrow="Poradnik APIXEL"
    title="Podejmij dobrą decyzję"
    accent="o stronie swojej firmy."
    description="Koszt, zakres, pozycjonowanie i kontakt. Odpowiadamy na pytania przed zamówieniem strony oraz podczas jej rozwoju."
    cta="Porozmawiajmy o Twojej firmie"
    compact
  />
  <section class="section section-white">
    <div class="container article-grid">
      {guides.map((guide) => (
        <article class="article-card">
          <p class="eyebrow">{guide.data.category}</p>
          <h2>
            <a href={`/poradnik/${guide.id}/`}>{guide.data.title}</a>
          </h2>
          <p>{guide.data.description}</p>
          <a class="text-link" href={`/poradnik/${guide.id}/`}>
            Przeczytaj poradnik ↗
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
