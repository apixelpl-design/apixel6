---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dziękujemy za zapytanie | APIXEL"
  description="Potwierdzenie przyjęcia zapytania przez formularz APIXEL."
  noindex
>
  <section class="section section-white">
    <div class="container">
      <p class="eyebrow">Wiadomość przyjęta</p>
      <h1>Dziękujemy za Twoje zapytanie.</h1>
      <p class="lead" style="margin-top:24px">
        Odezwiemy się, aby porozmawiać o Twojej firmie, ustalić zakres i kolejne
        kroki.
      </p>
      <div class="actions">
        <a class="button" href="/portfolio/">
          Zobacz nasze realizacje ↗
        </a>
        <a class="text-link" href="/">
          Wróć na stronę główną
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
