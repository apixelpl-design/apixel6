---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Nie znaleziono strony | APIXEL"
  description="Ten adres nie prowadzi do istniejącej strony APIXEL."
  noindex
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>Nie znaleźliśmy tej strony.</h1>
      <p class="lead" style="margin-top:24px">
        Sprawdź adres albo przejdź do naszej oferty.
      </p>
      <div class="actions">
        <a class="button" href="/uslugi/strona/">
          Zobacz ofertę stron ↗
        </a>
        <a class="text-link" href="/kontakt/">
          Kontakt
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
