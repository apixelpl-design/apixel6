---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import PreviewMotionControl from '../components/PreviewMotionControl.astro';
import { site } from '../data/site';
import { motionCssVariables, pageTransition } from '../data/motion';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../styles/site.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  noindex = false,
  image = site.sharingImage,
  type = 'website',
  schema,
  breadcrumbs,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalPath =
  pathname === '/' || /\.[a-z]+$/i.test(pathname) ? pathname : `${pathname}/`;
const canonical = new URL(canonicalPath, site.url).href;
const imageUrl = new URL(image, site.url).href;
const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    logo: new URL(site.logo, site.url).href,
    email: site.email,
    telephone: site.phoneNumber,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      postalCode: site.address.postalCode,
      addressLocality: site.address.city,
      addressCountry: site.address.country,
    },
    sameAs: site.socialLinks.map((link) => link.href),
    areaServed: site.area,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    name: site.name,
    url: site.url,
    inLanguage: 'pl-PL',
    publisher: { '@id': `${site.url}/#organization` },
  },
];
if (breadcrumbs?.length)
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: new URL(item.path, site.url).href,
    })),
  });
if (schema) schemas.push(...(Array.isArray(schema) ? schema : [schema]));
const jsonLd = JSON.stringify(schemas).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pl" style={motionCssVariables} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#080808" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={site.sharingDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={jsonLd} />
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="page-transition-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">
      Przejdź do treści
    </a>
    <Navbar />
    <main id="main" transition:animate={pageTransition}>
      <slot />
    </main>
    <PreviewMotionControl />
    <Footer />
    <Analytics />
    <script>
      import { initSiteMotion } from '../scripts/site-motion';
      initSiteMotion();

      const root = document.documentElement;
      let routeProgressTimer = 0;
      document.addEventListener('astro:before-preparation', () => {
        window.clearTimeout(routeProgressTimer);
        root.dataset.routeLoading = 'true';
      });
      document.addEventListener('astro:page-load', () => {
        if (root.dataset.routeLoading !== 'true') return;
        root.dataset.routeLoading = 'done';
        routeProgressTimer = window.setTimeout(() => {
          if (root.dataset.routeLoading === 'done')
            delete root.dataset.routeLoading;
        }, 180);
      });
    </script>
  </body>
</html>
